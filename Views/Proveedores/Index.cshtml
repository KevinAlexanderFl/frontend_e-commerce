@model IEnumerable<Proveedor>
@{ ViewData["Title"] = "Proveedores"; }
<div class="page-head"><div><span class="eyebrow">MÓDULO PROVEEDORES</span><h1>Proveedores</h1><p>Controla tus aliados comerciales y categorías de abastecimiento.</p></div><a class="btn primary" asp-action="Upsert">＋ Nuevo proveedor</a></div>
<section class="panel data-panel"><div class="toolbar"><label class="search">⌕ <input data-table-search="suppliersTable" placeholder="Buscar proveedor o contacto" /></label><span>@Model.Count() registros</span></div><div class="table-wrap"><table id="suppliersTable"><thead><tr><th>Proveedor</th><th>Contacto</th><th>Categoría</th><th>RUC</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><div class="entity supplier"><span>@(item.Nombre[..Math.Min(2,item.Nombre.Length)].ToUpper())</span><div><strong>@item.Nombre</strong><small>@item.Email</small></div></div></td><td><strong>@item.Contacto</strong><small>@item.Telefono</small></td><td>@item.Categoria</td><td>@item.Ruc</td><td><span class="badge @(item.Activo ? "ok" : "off")">@(item.Activo ? "Activo" : "Inactivo")</span></td><td><div class="actions"><a asp-action="Upsert" asp-route-id="@item.Id">✎</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Eliminar este proveedor?')"><button class="danger">×</button></form></div></td></tr> }
</tbody></table></div></section>
