@model Cliente
@{ ViewData["Title"] = Model.Id == 0 ? "Nuevo cliente" : "Editar cliente"; }
<div class="page-head"><div><span class="eyebrow">MÓDULO CLIENTES</span><h1>@ViewData["Title"]</h1><p>Completa los datos solicitados.</p></div></div>
<section class="panel form-card"><form asp-action="Upsert" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid">
    <label>Nombres<input asp-for="Nombres" /><span asp-validation-for="Nombres"></span></label>
    <label>Apellidos<input asp-for="Apellidos" /><span asp-validation-for="Apellidos"></span></label>
    <label>Correo electrónico<input asp-for="Email" /><span asp-validation-for="Email"></span></label>
    <label>Teléfono<input asp-for="Telefono" /><span asp-validation-for="Telefono"></span></label>
    <label>RUC / Cédula<input asp-for="Ruc" /><span asp-validation-for="Ruc"></span></label>
    <label class="check"><input asp-for="Activo" /> Cliente activo</label>
    <label class="wide">Dirección<input asp-for="Direccion" /><span asp-validation-for="Direccion"></span></label>
    <footer><a class="btn secondary" asp-action="Index">Cancelar</a><button class="btn primary">Guardar cliente</button></footer>
</div></form></section>
