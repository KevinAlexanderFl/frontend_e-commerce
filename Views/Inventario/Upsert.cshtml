@model Producto
@{ ViewData["Title"] = Model.Id == 0 ? "Nuevo producto" : "Editar producto"; }
<div class="page-head"><div><span class="eyebrow">MÓDULO INVENTARIO</span><h1>@ViewData["Title"]</h1><p>Define precio, existencias y proveedor.</p></div></div>
<section class="panel form-card"><form asp-action="Upsert" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid">
    <label>Código<input asp-for="Codigo" /><span asp-validation-for="Codigo"></span></label><label>Nombre<input asp-for="Nombre" /><span asp-validation-for="Nombre"></span></label>
    <label>Categoría<select asp-for="Categoria"><option>Tecnología</option><option>Moda</option><option>Hogar</option><option>Alimentos</option><option>Otros</option></select></label><label>Proveedor<select asp-for="ProveedorId" asp-items="ViewBag.Proveedores"><option value="">Seleccione...</option></select></label>
    <label>Stock<input asp-for="Stock" min="0" /><span asp-validation-for="Stock"></span></label><label>Stock mínimo<input asp-for="StockMinimo" min="0" /><span asp-validation-for="StockMinimo"></span></label>
    <label>Precio (USD)<input asp-for="Precio" min="0.01" step="0.01" /><span asp-validation-for="Precio"></span></label><label class="check"><input asp-for="Activo" /> Producto activo</label>
    <footer><a class="btn secondary" asp-action="Index">Cancelar</a><button class="btn primary">Guardar producto</button></footer>
</div></form></section>
