@model IEnumerable<Producto>
@{ ViewData["Title"] = "Inventario"; }
<div class="page-head"><div><span class="eyebrow">MÓDULO INVENTARIO</span><h1>Inventario</h1><p>Consulta existencias, precios y alertas de reposición.</p></div><a class="btn primary" asp-action="Upsert">＋ Nuevo producto</a></div>
<section class="panel data-panel"><div class="toolbar"><label class="search">⌕ <input data-table-search="productsTable" placeholder="Buscar código, producto o categoría" /></label><span>@Model.Count() productos</span></div><div class="table-wrap"><table id="productsTable"><thead><tr><th>Producto</th><th>Proveedor</th><th>Categoría</th><th>Stock</th><th>Precio</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><div class="entity product"><span>@(item.Nombre[..Math.Min(2,item.Nombre.Length)].ToUpper())</span><div><strong>@item.Nombre</strong><small>@item.Codigo</small></div></div></td><td>@item.Proveedor?.Nombre</td><td>@item.Categoria</td><td><div class="stock @(item.Stock <= item.StockMinimo ? "low" : "")"><strong>@item.Stock</strong><small>mín. @item.StockMinimo</small></div></td><td><strong>@item.Precio.ToString("C")</strong></td><td><span class="badge @(item.Activo && item.Stock > 0 ? "ok" : "off")">@(item.Activo && item.Stock > 0 ? "Disponible" : "Agotado")</span></td><td><div class="actions"><a asp-action="Upsert" asp-route-id="@item.Id">✎</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Eliminar este producto?')"><button class="danger">×</button></form></div></td></tr> }
</tbody></table></div></section>
