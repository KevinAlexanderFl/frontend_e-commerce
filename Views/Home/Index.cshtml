@model DashboardViewModel
@{ ViewData["Title"] = "Resumen"; }

<div class="page-head"><div><span class="eyebrow">RESUMEN GENERAL</span><h1>El negocio, de un vistazo</h1><p>Supervisa ventas, pedidos y existencias desde un solo lugar.</p></div></div>
<section class="stats">
    <article><span class="stat-icon blue">C</span><div><small>Clientes registrados</small><strong>@Model.Clientes</strong><em>Base comercial</em></div></article>
    <article><span class="stat-icon purple">P</span><div><small>Productos activos</small><strong>@Model.Productos</strong><em>@Model.StockBajo.Count requieren atención</em></div></article>
    <article><span class="stat-icon orange">#</span><div><small>Pedidos totales</small><strong>@Model.Pedidos</strong><em>Flujo actualizado</em></div></article>
    <article><span class="stat-icon green">$</span><div><small>Ingresos aprobados</small><strong>@Model.Ingresos.ToString("C")</strong><em>Pagos confirmados</em></div></article>
</section>
<div class="dashboard-grid">
    <section class="panel">
        <header class="panel-head"><div><span class="eyebrow">ACTIVIDAD</span><h2>Pedidos recientes</h2></div></header>
        <div class="table-wrap"><table><thead><tr><th>Pedido</th><th>Cliente</th><th>Fecha</th><th>Total</th><th>Estado</th></tr></thead><tbody>
        @if (Model.PedidosRecientes.Count == 0) { <tr><td colspan="5" class="empty">Aún no existen pedidos.</td></tr> }
        @foreach (var item in Model.PedidosRecientes) { <tr><td><strong>@item.Numero</strong></td><td>@item.Cliente?.Nombres @item.Cliente?.Apellidos</td><td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td><strong>@item.Total.ToString("C")</strong></td><td><span class="badge">@item.Estado</span></td></tr> }
        </tbody></table></div>
    </section>
    <section class="panel stock-panel">
        <header class="panel-head"><div><span class="eyebrow">INVENTARIO</span><h2>Stock por reponer</h2></div><span class="warn">!</span></header>
        @if (Model.StockBajo.Count == 0) { <p class="empty">El inventario está abastecido.</p> }
        @foreach (var item in Model.StockBajo) { <div class="stock-item"><span>@(item.Nombre[..Math.Min(2,item.Nombre.Length)].ToUpper())</span><div><strong>@item.Nombre</strong><small>@item.Codigo</small></div><aside><strong>@item.Stock</strong><small>mín. @item.StockMinimo</small></aside></div> }
    </section>
</div>
