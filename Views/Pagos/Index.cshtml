@model IEnumerable<Pago>
@{ ViewData["Title"] = "Pagos"; var approved = Model.Where(item => item.Estado == "Aprobado").Sum(item => item.Monto); var pending = Model.Where(item => item.Estado == "Pendiente").Sum(item => item.Monto); }
<div class="page-head"><div><span class="eyebrow">MÓDULO PAGOS</span><h1>Pagos</h1><p>Controla cobros, referencias y estados de transacción.</p></div></div>
<section class="payment-stats"><article><span class="stat-icon green">✓</span><div><small>Total aprobado</small><strong>@approved.ToString("C")</strong></div></article><article><span class="stat-icon orange">$</span><div><small>Pendiente de confirmar</small><strong>@pending.ToString("C")</strong></div></article></section>
<section class="panel data-panel"><div class="toolbar"><label class="search">⌕ <input data-table-search="paymentsTable" placeholder="Buscar pedido, referencia o método" /></label><span>@Model.Count() transacciones</span></div><div class="table-wrap"><table id="paymentsTable"><thead><tr><th>Referencia</th><th>Pedido</th><th>Método</th><th>Fecha</th><th>Monto</th><th>Estado</th></tr></thead><tbody>
@if (!Model.Any()) { <tr><td colspan="6" class="empty">No existen pagos registrados.</td></tr> }
@foreach (var item in Model) { <tr><td><div class="entity payment"><span>$</span><div><strong>@item.Referencia</strong><small>ID #@item.Id</small></div></div></td><td><strong>@item.Pedido?.Numero</strong></td><td>@item.Metodo</td><td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td><strong>@item.Monto.ToString("C")</strong></td><td><form class="inline-form" asp-action="ChangeStatus" method="post"><input type="hidden" name="id" value="@item.Id" /><select name="estado" onchange="this.form.submit()">@foreach (var status in new[] { "Aprobado", "Pendiente", "Rechazado" }) { if (item.Estado == status) { <option selected>@status</option> } else { <option>@status</option> } }</select></form></td></tr> }
</tbody></table></div></section>
